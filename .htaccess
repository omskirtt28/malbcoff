# Malbcoff Trading - public web root protection and clean URLs
# Apache 2.4+ / common shared-hosting safe rules.

DirectoryIndex index.php

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Internal application/source folders must never be requested directly.
    RewriteRule ^(?:config|core|database|pages|partials|design-reference|\.git)(?:/|$) - [F,L,NC]

    # Development artifacts / backups / documentation are not public assets.
    RewriteRule ^(?:preview\.html|.*\.(?:md|sql|zip|bak|backup|log|ini|dist))$ - [F,L,NC]

    # Patch 6b: static files requested with a version (assets/…?v=<filemtime>) may be cached for a year,
    # because every change to the file changes the URL. Used by the Cache-Control header further down.
    RewriteCond %{QUERY_STRING} (?:^|&)v=\d+(?:&|$)
    RewriteRule ^assets/.+\.(?:css|js)$ - [E=ASSET_VERSIONED:1]

    # Existing public files/folders (assets and action endpoints) keep working.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Keep canonical clean URLs without a trailing slash.
    RewriteRule ^(.+)/$ $1 [R=301,L]

    # Authentication / utility routes.
    RewriteRule ^login$ login.php [L,QSA]
    RewriteRule ^logout$ logout.php [L,QSA]
    RewriteRule ^change-password$ change-password.php [L,QSA]
    RewriteRule ^maintenance$ maintenance.php [L,QSA]

    # Application module routes. PHP files remain internal implementation details.
    RewriteRule ^pos$ index.php?page=pos [L,QSA]
    RewriteRule ^sales-records$ index.php?page=sales-records [L,QSA]
    RewriteRule ^products$ index.php?page=products [L,QSA]
    RewriteRule ^archive$ index.php?page=products&status=archived [L,QSA]
    RewriteRule ^add-item$ index.php?page=add-item [L,QSA]
    RewriteRule ^inventory$ index.php?page=inventory [L,QSA]
    RewriteRule ^stock-monitoring$ index.php?page=stock-monitoring [L,QSA]
    RewriteRule ^stock-monitoring/export$ actions/export_stock_monitoring.php [L,QSA]
    RewriteRule ^branch-transfers$ index.php?page=branch-transfers [L,QSA]
    RewriteRule ^receive-stock$ index.php?page=stock-in [L,QSA]
    RewriteRule ^stock-movement$ index.php?page=stock-movement [L,QSA]
    RewriteRule ^users$ index.php?page=users [L,QSA]
    RewriteRule ^account$ index.php?page=account [L,QSA]
    RewriteRule ^needs-action$ index.php?page=needs-action [L,QSA]

    # System Admin routes stay flat so existing relative assets/actions remain safe.
    RewriteRule ^system-admin$ index.php?page=system-admin-dashboard [L,QSA]
    RewriteRule ^system-admin-users$ index.php?page=system-admin-users [L,QSA]
    RewriteRule ^system-admin-history$ index.php?page=system-admin-history [L,QSA]
    RewriteRule ^security-logs$ index.php?page=security-logs [L,QSA]
    RewriteRule ^system-admin-data-reset$ index.php?page=system-admin-data-reset [L,QSA]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.env(?:\..*)?|\.gitignore|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml.*|bootstrap\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# ---------------------------------------------------------------------------------------------
# Patch 6b — fast loading on weak internet (static files only; PHP pages are never cached)
# ---------------------------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_headers.c>
    # Versioned CSS/JS (…?v=123): safe to keep for a year. Both names cover an internal rewrite.
    Header set Cache-Control "public, max-age=31536000, immutable" env=ASSET_VERSIONED
    Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_ASSET_VERSIONED

    # The service worker, its offline page and the manifest must always be re-checked, so a new deploy is seen at once.
    <FilesMatch "^(?:sw\.js|offline\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# gzip/deflate for text-like static files only (never HTML pages or JSON answers that can carry tokens).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css text/javascript application/javascript application/x-javascript image/svg+xml application/manifest+json application/wasm
</IfModule>
